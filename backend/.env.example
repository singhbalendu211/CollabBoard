# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.wlnavts.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Secret for token signing
JWT_SECRET=your_jwt_secret_here

# Unsplash API Key (for dynamic room images)
# Get your free API key from: https://unsplash.com/developers
UNSPLASH_API_KEY=your_unsplash_api_key_here
